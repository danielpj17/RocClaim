{
  "manifest_version": 3,
  "name": "ROC Claim Watcher",
  "version": "0.1.0",
  "description": "Watches one BYU ROC event page in your own browser and pushes your phone when a ticket becomes claimable.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://byutickets.evenue.net/*",
    "https://ntfy.sh/*",
    "https://api.telegram.org/*",
    "https://discord.com/api/*",
    "https://discordapp.com/api/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://byutickets.evenue.net/*"
      ],
      "js": [
        "detect.js",
        "probe-dom.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://byutickets.evenue.net/cart*",
        "https://byutickets.evenue.net/checkout*",
        "https://byutickets.evenue.net/order/*"
      ],
      "js": [
        "close-cart.js",
        "cart.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ROC Claim Watcher",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}
