{
  "name": "roc-claim",
  "version": "0.2.0",
  "private": true,
  "description": "Watches the BYU ROC last-chance claim for returned tickets and claims one.",
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --fake",
    "login": "node login.js",
    "record": "node record.js",
    "record:watch": "node record-watch.js",
    "test": "node --test",
    "tunnel": "%USERPROFILE%\\bin\\cloudflared.exe tunnel --url http://localhost:4321",
    "up": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1",
    "up:fake": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1 -Fake",
    "down": "powershell -ExecutionPolicy Bypass -File ./stop-all.ps1",
    "recon:up": "powershell -ExecutionPolicy Bypass -File ./watch-recon.ps1",
    "recon:down": "powershell -ExecutionPolicy Bypass -File ./stop-recon.ps1"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
