{
  "manifest_version": 3,
  "name": "ROC API Watcher",
  "version": "0.1.0",
  "description": "Asks BYU's seat-search endpoint directly for one ROC event and pushes your phone when a seat is reserved.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://byutickets.evenue.net/*",
    "https://ntfy.sh/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://byutickets.evenue.net/students/event/*"
      ],
      "js": [
        "api.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://byutickets.evenue.net/cart*",
        "https://byutickets.evenue.net/checkout*",
        "https://byutickets.evenue.net/order/*"
      ],
      "js": [
        "close-cart.js",
        "cart.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ROC API Watcher",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}
